  #ImageCustomizer-{{ section.id }} .image-customizer-tool__row { display: grid; grid-template-columns: 120px 1fr; gap: 10px; align-items: center; }
  #ImageCustomizer-{{ section.id }} .image-customizer-tool__sizes { display: flex; gap: 10px; flex-wrap: wrap; }
  #ImageCustomizer-{{ section.id }} .image-customizer-tool__hidden { display: none !important; }
  #ImageCustomizer-{{ section.id }} .image-customizer-tool__modal { position: fixed; inset: 0; z-index: 50; display: flex; align-items: center; justify-content: center; padding: 16px; }
  #ImageCustomizer-{{ section.id }} .image-customizer-tool__modal-backdrop { position: absolute; inset: 0; background: rgba(0,0,0,0.45); }
  #ImageCustomizer-{{ section.id }} .image-customizer-tool__modal-panel { position: relative; width: min(960px, 100%); max-height: 85vh; overflow: auto; background: #fff; border-radius: 10px; padding: 14px; }
  #ImageCustomizer-{{ section.id }} .image-customizer-tool__modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
  #ImageCustomizer-{{ section.id }} .image-customizer-tool__template-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
  #ImageCustomizer-{{ section.id }} .image-customizer-tool__template-grid button { border: 1px solid #ddd; border-radius: 8px; background: #fff; padding: 0; cursor: pointer; overflow: hidden; text-align: left; }
  #ImageCustomizer-{{ section.id }} .image-customizer-tool__template-grid img { width: 100%; height: 150px; object-fit: cover; display: block; }
  #ImageCustomizer-{{ section.id }} .image-customizer-tool__template-grid span { display: block; padding: 6px 8px; font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  #ImageCustomizer-{{ section.id }} .image-customizer-tool__modal-toolbar { margin-bottom: 10px; }
  #ImageCustomizer-{{ section.id }} .image-customizer-tool__modal-search { width: 97%; max-width: 100%; padding: 10px 12px; border: 1px solid #000; border-radius: 6px; font-size: 15px; background: transparent;}
  #ImageCustomizer-{{ section.id }} .image-customizer-tool__modal-pagination { display: flex; align-items: center; justify-content: center; gap: 12px; flex-wrap: wrap; margin-top: 14px; padding-top: 12px; border-top: 1px solid #621329; }
  #ImageCustomizer-{{ section.id }} .image-customizer-tool__page-info { font-size: 14px; color: #000; min-width: 150px; text-align: center; }
  #ImageCustomizer-{{ section.id }} .image-customizer-tool__page-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  #ImageCustomizer-{{ section.id }} .visually-hidden {
    position: absolute !important;
