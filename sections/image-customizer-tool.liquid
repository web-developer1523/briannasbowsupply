  #ImageCustomizer-{{ section.id }} .image-customizer-tool__ruler { background: #f7f7f7; display: block; }
  #ImageCustomizer-{{ section.id }} .image-customizer-tool__ruler--top { width: 100%; height: 28px; border-bottom: 1px solid #222; }
  #ImageCustomizer-{{ section.id }} .image-customizer-tool__ruler--left { width: 28px; height: 100%; border-right: 1px solid #222; }
  #ImageCustomizer-{{ section.id }} .image-customizer-tool__preview-wrap { box-sizing: border-box; width: 100%; max-width: 100%; overflow: hidden; background: #fff; border: 1px solid #d5d5d5; justify-self: center; align-self: center; }
