<div id="ImageCustomizer-{{ section.id }}" class="image-customizer-tool" data-section-id="{{ section.id }}">
  <div class="image-customizer-tool__layout">
    <div class="image-customizer-tool__preview">
      <div class="image-customizer-tool__frame">
        <div class="image-customizer-tool__corner">IN</div>
        <canvas id="CustomizerRulerTop-{{ section.id }}" class="image-customizer-tool__ruler image-customizer-tool__ruler--top" width="700" height="34"></canvas>
        <canvas id="CustomizerRulerLeft-{{ section.id }}" class="image-customizer-tool__ruler image-customizer-tool__ruler--left" width="34" height="500"></canvas>
        <div class="image-customizer-tool__preview-wrap">
          <canvas id="CustomizerCanvas-{{ section.id }}" width="700" height="500"></canvas>
        </div>
      </div>
      <div class="image-customizer-tool__zoom-bar" id="CustomizerZoomBar-{{ section.id }}" aria-label="Preview zoom">
        <button type="button" class="image-customizer-tool__zoom-btn" id="CustomizerZoomOut-{{ section.id }}" aria-label="Zoom out">&#8722;</button>
        <span class="image-customizer-tool__zoom-pct" id="CustomizerZoomPct-{{ section.id }}">100%</span>
        <button type="button" class="image-customizer-tool__zoom-btn" id="CustomizerZoomIn-{{ section.id }}" aria-label="Zoom in">+</button>
      </div>
    </div>

    <div class="image-customizer-tool__controls">
       <div class="image-customizer-tool__source-options">
        <label><input type="radio" name="customizerSource-{{ section.id }}" value="upload" checked> Upload File</label>
        <label><input type="radio" name="customizerSource-{{ section.id }}" value="template"> Select From Gallery</label>
      </div> 

      <div id="CustomizerUploadBlock-{{ section.id }}">
        <label for="CustomizerUploadInput-{{ section.id }}">File Upload</label>
        <input id="CustomizerUploadInput-{{ section.id }}" type="file" accept="image/*">
      </div>

      <button type="button" id="CustomizerOpenTemplatePicker-{{ section.id }}" class="btn image-customizer-tool__template-btn image-customizer-tool__hidden">Browse Gallery</button>

      <div class="image-customizer-tool__scale">
        <label for="CustomizerScale-{{ section.id }}">
          Adjust Scale:
          <span id="CustomizerScaleValue-{{ section.id }}">12.00 X 12.00in</span>
        </label>
        <input id="CustomizerScale-{{ section.id }}" type="range" min="0.1" max="58" step="0.01" value="12">
      </div>

      <div class="image-customizer-tool__row">
        <label>Preview Size</label>
        <div id="CustomizerSizes-{{ section.id }}" class="image-customizer-tool__sizes">
          <label><input type="radio" name="customizerSize-{{ section.id }}" value="12x12" checked> 12×12</label>
          <label><input type="radio" name="customizerSize-{{ section.id }}" value="58x36"> 58×36</label>
        </div>
      </div>

      <div class="image-customizer-tool__row">
        <label for="CustomizerWidth-{{ section.id }}">Image Width</label>
        <input id="CustomizerWidth-{{ section.id }}" type="number" min="0.01" step="0.01" value="12.00">
      </div>

      <div class="image-customizer-tool__row">
        <label for="CustomizerHeight-{{ section.id }}">Image Height</label>
        <input id="CustomizerHeight-{{ section.id }}" type="number" min="0.01" step="0.01" value="12.00">
      </div>
    </div>
  </div>

  {% assign gallery_metaobject_empty = '' | split: '__EMPTY_ARRAY__' %}
  {% assign design_library_entries = shop.metaobjects.design_library.values %}
  {% assign design_library_2_entries = shop.metaobjects.design_library_2.values %}
  {% unless design_library_entries %}
    {% assign design_library_entries = gallery_metaobject_empty %}
  {% endunless %}
  {% unless design_library_2_entries %}
    {% assign design_library_2_entries = gallery_metaobject_empty %}
  {% endunless %}
  {% if design_library_entries.size > 0 or design_library_2_entries.size > 0 %}
    <script type="application/json" id="CustomizerTemplateLibrary-{{ section.id }}">
      {% render 'design-library-gallery-array', design_library_entries: design_library_entries, design_library_2_entries: design_library_2_entries, image_width: 1500 %}
    </script>
  {% endif %}

  <div id="CustomizerTemplateModal-{{ section.id }}" class="image-customizer-tool__modal image-customizer-tool__hidden" aria-hidden="true">
    <div class="image-customizer-tool__modal-backdrop" data-customizer-close-modal></div>
    <div class="image-customizer-tool__modal-panel" role="dialog" aria-modal="true" aria-label="Template image library">
      <div class="image-customizer-tool__modal-header">
        <h3>BBSS Co. Gallery</h3>
        <button type="button" data-customizer-close-modal aria-label="Close">X</button>
      </div>
      <div class="image-customizer-tool__modal-toolbar">
        <label class="visually-hidden" for="CustomizerTemplateSearch-{{ section.id }}">Search templates</label>
        <input type="search" id="CustomizerTemplateSearch-{{ section.id }}" class="image-customizer-tool__modal-search" placeholder="Search..." autocomplete="off">
      </div>
      <div id="CustomizerTemplateGrid-{{ section.id }}" class="image-customizer-tool__template-grid"></div>
      <div id="CustomizerTemplatePagination-{{ section.id }}" class="image-customizer-tool__modal-pagination image-customizer-tool__hidden">
        <button type="button" class="btn image-customizer-tool__page-btn" id="CustomizerTemplatePrev-{{ section.id }}">Previous</button>
        <span class="image-customizer-tool__page-info" id="CustomizerTemplatePageInfo-{{ section.id }}"></span>
        <button type="button" class="btn image-customizer-tool__page-btn" id="CustomizerTemplateNext-{{ section.id }}">Next</button>
      </div>
      <p id="CustomizerTemplateEmpty-{{ section.id }}" class="image-customizer-tool__template-empty image-customizer-tool__hidden">No template images found.</p>
    </div>
  </div>
</div>

