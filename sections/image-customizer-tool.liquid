  #ImageCustomizer-{{ section.id }} .image-customizer-tool__zoom-bar { display: flex; align-items: center; justify-content: flex-end; gap: 10px; margin-top: 10px; padding: 0 2px; }
  #ImageCustomizer-{{ section.id }} .image-customizer-tool__zoom-btn { width: 36px; height: 32px; border: 1px solid #bbb; border-radius: 6px; background: #fff; font-size: 20px; line-height: 1; cursor: pointer; color: #222; padding: 0; }
  #ImageCustomizer-{{ section.id }} .image-customizer-tool__zoom-btn:hover { border-color: #222; background: #f5f5f5; }
