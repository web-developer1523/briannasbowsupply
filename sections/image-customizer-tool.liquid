  }
  @media (min-width: 990px) {
    #ImageCustomizer-{{ section.id }} .image-customizer-tool__preview {
      width: 100%;
    }
  }
</style>

<script>
  (function() {
    var sectionId = '{{ section.id }}';
    var root = document.getElementById('ImageCustomizer-' + sectionId);
    if (!root) return;

    var canvas = document.getElementById('CustomizerCanvas-' + sectionId);
    var topRulerCanvas = document.getElementById('CustomizerRulerTop-' + sectionId);
    var leftRulerCanvas = document.getElementById('CustomizerRulerLeft-' + sectionId);
    var previewWrap = root.querySelector('.image-customizer-tool__preview-wrap');
    var previewFrame = root.querySelector('.image-customizer-tool__frame');
    var scaleSlider = document.getElementById('CustomizerScale-' + sectionId);
    var scaleValue = document.getElementById('CustomizerScaleValue-' + sectionId);
    var previewZoomOut = document.getElementById('CustomizerZoomOut-' + sectionId);
    var previewZoomIn = document.getElementById('CustomizerZoomIn-' + sectionId);
    var previewZoomPct = document.getElementById('CustomizerZoomPct-' + sectionId);
    var sizeWrap = document.getElementById('CustomizerSizes-' + sectionId);
    var widthInput = document.getElementById('CustomizerWidth-' + sectionId);
    var heightInput = document.getElementById('CustomizerHeight-' + sectionId);
    var uploadBlock = document.getElementById('CustomizerUploadBlock-' + sectionId);
    var uploadInput = document.getElementById('CustomizerUploadInput-' + sectionId);
    var sourceRadios = root.querySelectorAll('input[name="customizerSource-' + sectionId + '"]');
    var openTemplateButton = document.getElementById('CustomizerOpenTemplatePicker-' + sectionId);
    var templateModal = document.getElementById('CustomizerTemplateModal-' + sectionId);
    var templateGrid = document.getElementById('CustomizerTemplateGrid-' + sectionId);
    var templateEmpty = document.getElementById('CustomizerTemplateEmpty-' + sectionId);
    var templateSearch = document.getElementById('CustomizerTemplateSearch-' + sectionId);
    var templatePagination = document.getElementById('CustomizerTemplatePagination-' + sectionId);
    var templatePrev = document.getElementById('CustomizerTemplatePrev-' + sectionId);
    var templateNext = document.getElementById('CustomizerTemplateNext-' + sectionId);
    var templatePageInfo = document.getElementById('CustomizerTemplatePageInfo-' + sectionId);
    var templateDataScript = document.getElementById('CustomizerTemplateLibrary-' + sectionId);

    if (!canvas || !topRulerCanvas || !leftRulerCanvas || !previewWrap || !previewFrame || !scaleSlider || !sizeWrap || !widthInput || !heightInput) return;

    var ctx = canvas.getContext('2d');
    var topCtx = topRulerCanvas.getContext('2d');
    var leftCtx = leftRulerCanvas.getContext('2d');
    var uploadedImage = null;
    var imageAspectRatio = 1;
    var canvasInches = { width: 12, height: 12 };
    var activeSizePreset = '';
    var templateItems = [];
    var rulerThickness = 28;
    var TEMPLATE_PAGE_SIZE = 15;
    var templateCurrentPage = 1;
    var templateSearchTimer = null;
    var PREVIEW_ZOOM_STEP = 2;
    var PREVIEW_ZOOM_MIN_PCT = 25;
    var PREVIEW_ZOOM_MAX_PCT = 800;
    var previewZoomPercent = 100;

    function parseTemplateItems() {
      if (!templateDataScript) return [];
      try {
        var parsed = JSON.parse(templateDataScript.textContent || '[]');
        if (!Array.isArray(parsed)) return [];
        return parsed.filter(function(item) {
          return item && typeof item.url === 'string' && item.url.trim() !== '';
        }).map(function(item, i) {
          return { url: item.url.trim(), alt: item.alt || ('Template ' + (i + 1)) };
        });
      } catch (e) {
        return [];
      }
    }

    function syncCanvasToViewport() {
      var w = Math.max(1, Math.round(previewWrap.clientWidth));
      var h = Math.max(1, Math.round(previewWrap.clientHeight));
      if (canvas.width !== w || canvas.height !== h) { canvas.width = w; canvas.height = h; }
      if (topRulerCanvas.width !== w || topRulerCanvas.height !== rulerThickness) { topRulerCanvas.width = w; topRulerCanvas.height = rulerThickness; }
      if (leftRulerCanvas.width !== rulerThickness || leftRulerCanvas.height !== h) { leftRulerCanvas.width = rulerThickness; leftRulerCanvas.height = h; }
    }

    function layoutPreviewFrame() {
      if (!previewFrame || !previewWrap) return;
      var parent = previewFrame.parentElement;
      var capOuterW = parent && parent.clientWidth > 0 ? parent.clientWidth : previewFrame.clientWidth;
      if (!capOuterW || capOuterW < 40) capOuterW = Math.max(previewFrame.clientWidth, 320);
      capOuterW = Math.min(capOuterW, 700);
      var capOuterH = Math.min(window.innerHeight * 0.72, 760);
      capOuterW = Math.floor(capOuterW);

      var borderSlack = 4;
      var innerMaxW = Math.max(24, capOuterW - rulerThickness - borderSlack);
      var innerMaxH = Math.max(24, capOuterH - rulerThickness - borderSlack);

      var px = Math.min(innerMaxW / canvasInches.width, innerMaxH / canvasInches.height);
      var contentW = Math.max(1, Math.floor(canvasInches.width * px));
      var contentH = Math.max(1, Math.round(contentW * canvasInches.height / canvasInches.width));
      if (contentH > innerMaxH) {
        contentH = Math.max(1, Math.floor(canvasInches.height * px));
        contentW = Math.max(1, Math.round(contentH * canvasInches.width / canvasInches.height));
      }
      while (contentW + rulerThickness + borderSlack > capOuterW && contentW > 24) {
        contentW--;
        contentH = Math.max(1, Math.round(contentW * canvasInches.height / canvasInches.width));
      }
      while (contentH + rulerThickness + borderSlack > capOuterH && contentH > 24) {
        contentH--;
        contentW = Math.max(1, Math.round(contentH * canvasInches.width / canvasInches.height));
      }

      var outerW = rulerThickness + contentW;
      var outerH = rulerThickness + contentH;
      previewFrame.style.width = outerW + 'px';
      previewFrame.style.height = outerH + 'px';
      previewFrame.style.boxSizing = 'border-box';
      previewFrame.style.maxWidth = '100%';
      previewWrap.style.width = contentW + 'px';
      previewWrap.style.height = contentH + 'px';
    }

    function isFullYardCanvas() {
      return canvasInches.width === 58 && canvasInches.height === 36;
    }

    function getScaleSliderMax() {
      return isFullYardCanvas() ? 58 : 12;
    }

    function getDefaultPrintWidthInches() {
      var cw = canvasInches.width;
      var ch = canvasInches.height;
      var ar = Math.max(imageAspectRatio, 0.001);
      return Math.min(cw, ch / ar);
    }

    function getPrintWidthInches() {
      var m = getScaleSliderMax();
      var v = parseFloat(scaleSlider.value);
      if (!isFinite(v)) v = getDefaultPrintWidthInches();
      return Math.min(Math.max(v, 0.1), m);
    }

    function syncScaleSliderMax() {
      if (!scaleSlider) return;
      var m = getScaleSliderMax();
      scaleSlider.setAttribute('max', String(m));
      var v = parseFloat(scaleSlider.value);
      if (!isFinite(v)) v = 0.1;
      v = Math.min(Math.max(v, 0.1), m);
      scaleSlider.value = v.toFixed(2);
    }

    function applyFitPrintWidth() {
      syncScaleSliderMax();
      scaleSlider.value = getDefaultPrintWidthInches().toFixed(2);
    }

    function getMajorStep(pxPerUnit) {
      if (pxPerUnit >= 20) return 1;
      if (pxPerUnit >= 10) return 2;
      if (pxPerUnit >= 6) return 5;
      return 10;
    }

    function drawTopRuler(inches) {
      var w = topRulerCanvas.width;
      var h = topRulerCanvas.height;
      var px = w / Math.max(inches, 0.001);
      var step = getMajorStep(px);
      var labelMinGapPx = 30;
      topCtx.clearRect(0, 0, w, h);
      topCtx.fillStyle = '#f7f7f7';
      topCtx.fillRect(0, 0, w, h);
      topCtx.strokeStyle = '#111';
      topCtx.fillStyle = '#111';
      topCtx.font = '12px Arial, sans-serif';
      topCtx.textAlign = 'center';
      topCtx.textBaseline = 'top';
      var maxInchesTop = Math.ceil(inches);
      var xEnd = Math.round(maxInchesTop * px) + 0.5;
      for (var i = 0; i <= maxInchesTop; i++) {
        var x = Math.round(i * px) + 0.5;
        if (x < 0 || x > w + 1) continue;
        var major = i % step === 0;
        topCtx.beginPath();
        topCtx.moveTo(x, h);
        topCtx.lineTo(x, h - (major ? 12 : 7));
        topCtx.stroke();
        var showLabel = (major && i > 0) || (i > 0 && i === maxInchesTop);
        if (showLabel) {
          if (i < maxInchesTop && (xEnd - x) < labelMinGapPx) {
            continue;
          }
          topCtx.fillText(String(i), Math.max(8, Math.min(w - 8, x)), 3);
        }
      }
    }

    function drawLeftRuler(inches) {
      var w = leftRulerCanvas.width;
      var h = leftRulerCanvas.height;
      var px = h / Math.max(inches, 0.001);
      var step = getMajorStep(px);
      var labelMinGapPx = 30;
      leftCtx.clearRect(0, 0, w, h);
      leftCtx.fillStyle = '#f7f7f7';
      leftCtx.fillRect(0, 0, w, h);
      leftCtx.strokeStyle = '#111';
      leftCtx.fillStyle = '#111';
      leftCtx.font = '12px Arial, sans-serif';
      leftCtx.textAlign = 'left';
      leftCtx.textBaseline = 'middle';
      var maxInchesLeft = Math.ceil(inches);
      var yEnd = Math.round(maxInchesLeft * px) + 0.5;
      for (var i = 0; i <= maxInchesLeft; i++) {
        var y = Math.round(i * px) + 0.5;
        if (y < 0 || y > h + 1) continue;
        var major = i % step === 0;
        leftCtx.beginPath();
        leftCtx.moveTo(w, y);
        leftCtx.lineTo(w - (major ? 12 : 7), y);
        leftCtx.stroke();
        var showLabel = (major && i > 0) || (i > 0 && i === maxInchesLeft);
        if (showLabel) {
          if (i < maxInchesLeft && (yEnd - y) < labelMinGapPx) {
            continue;
          }
          leftCtx.fillText(String(i), 3, Math.max(8, Math.min(h - 8, y)));
        }
      }
    }

    function updatePreviewZoomPctLabel() {
      if (!previewZoomPct) return;
      previewZoomPct.textContent = Math.round(previewZoomPercent) + '%';
    }

    function stepPreviewZoom(multiply) {
      var nextPct = previewZoomPercent * multiply;
      nextPct = Math.min(Math.max(nextPct, PREVIEW_ZOOM_MIN_PCT), PREVIEW_ZOOM_MAX_PCT);
      previewZoomPercent = nextPct;
      updatePreviewZoomPctLabel();
      drawImage();
    }

    function syncScaleOutputs() {
      var pw = getPrintWidthInches();
      var ph = pw * imageAspectRatio;
      scaleValue.textContent = pw.toFixed(2) + ' X ' + ph.toFixed(2) + 'in';
      widthInput.value = pw.toFixed(2);
      heightInput.value = ph.toFixed(2);
      updatePreviewZoomPctLabel();
    }

    function drawImage() {
      layoutPreviewFrame();
      syncCanvasToViewport();
      var zoomFactor = Math.max(previewZoomPercent / 100, 0.01);
      var visibleWidthInches = canvasInches.width / zoomFactor;
      var visibleHeightInches = canvasInches.height / zoomFactor;
      drawTopRuler(visibleWidthInches);
      drawLeftRuler(visibleHeightInches);
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      if (!uploadedImage) return;

      var pxPerInch = canvas.width / Math.max(visibleWidthInches, 0.001);
      var printW = getPrintWidthInches();
      var drawW = Math.max(1, Math.round(printW * pxPerInch));
      var drawH = Math.max(1, Math.round(printW * imageAspectRatio * pxPerInch));

      ctx.imageSmoothingEnabled = true;

      var tileCanvas = document.createElement('canvas');
      tileCanvas.width = drawW;
      tileCanvas.height = drawH;
      var tileCtx = tileCanvas.getContext('2d');
      tileCtx.imageSmoothingEnabled = true;
      tileCtx.drawImage(uploadedImage, 0, 0, drawW, drawH);

      var pattern = ctx.createPattern(tileCanvas, 'repeat');
      ctx.fillStyle = pattern;
      ctx.fillRect(0, 0, canvas.width, canvas.height);
    }

    function applyCanvasSizePreset(value) {
      if (!value || value === activeSizePreset) return;
      var parts = value.split('x');
      var w = parseFloat(parts[0]);
      var h = parseFloat(parts[1]);
      if (!isFinite(w) || !isFinite(h) || w <= 0 || h <= 0) return;
      canvasInches = { width: w, height: h };
      activeSizePreset = value;
      applyFitPrintWidth();
      syncScaleOutputs();
      drawImage();
    }

    function loadImageFromUrl(url) {
      if (!url) return;
      var img = new Image();
      img.crossOrigin = 'anonymous';
      img.onload = function() {
        uploadedImage = img;
        imageAspectRatio = img.naturalHeight > 0 && img.naturalWidth > 0 ? img.naturalHeight / img.naturalWidth : 1;
        applyFitPrintWidth();
        syncScaleOutputs();
        drawImage();
      };
      img.onerror = function() {};
      img.src = url;
    }

    function loadImageFromFile(file) {
      if (!file) return;
      var reader = new FileReader();
      reader.onload = function(evt) {
        if (evt && evt.target && evt.target.result) loadImageFromUrl(evt.target.result);
      };
      reader.readAsDataURL(file);
    }

    function updateSourceUI(mode) {
      var useTemplate = mode === 'template';
      if (uploadBlock) uploadBlock.classList.toggle('image-customizer-tool__hidden', useTemplate);
      if (openTemplateButton) openTemplateButton.classList.toggle('image-customizer-tool__hidden', !useTemplate);
      if (!useTemplate && templateModal) {
        templateModal.classList.add('image-customizer-tool__hidden');
        templateModal.setAttribute('aria-hidden', 'true');
      }
    }

    function openTemplateModal() {
      if (!templateModal) return;
      templateCurrentPage = 1;
      if (templateSearch) templateSearch.value = '';
      renderTemplateGrid();
      templateModal.classList.remove('image-customizer-tool__hidden');
      templateModal.setAttribute('aria-hidden', 'false');
      if (templateSearch) {
        try {
          templateSearch.focus();
        } catch (e) {
        }
      }
    }

    function closeTemplateModal() {
      if (!templateModal) return;
      templateModal.classList.add('image-customizer-tool__hidden');
      templateModal.setAttribute('aria-hidden', 'true');
    }

    function getFilteredTemplateItems() {
      var q = templateSearch && templateSearch.value ? templateSearch.value.trim().toLowerCase() : '';
      if (!q) return templateItems.slice();
      return templateItems.filter(function(t) {
        var alt = (t.alt || '').toLowerCase();
        var url = (t.url || '').toLowerCase();
        return alt.indexOf(q) !== -1 || url.indexOf(q) !== -1;
      });
    }

    function renderTemplateGrid() {
      if (!templateGrid || !templateEmpty) return;
      templateGrid.innerHTML = '';
      if (!templateItems.length) {
        templateEmpty.textContent = 'No template images found.';
        templateEmpty.classList.remove('image-customizer-tool__hidden');
        if (templatePagination) templatePagination.classList.add('image-customizer-tool__hidden');
        return;
      }
      var filtered = getFilteredTemplateItems();
      if (!filtered.length) {
        templateEmpty.textContent = 'No templates match your search.';
        templateEmpty.classList.remove('image-customizer-tool__hidden');
        if (templatePagination) templatePagination.classList.add('image-customizer-tool__hidden');
        return;
      }
      templateEmpty.classList.add('image-customizer-tool__hidden');
      var totalPages = Math.max(1, Math.ceil(filtered.length / TEMPLATE_PAGE_SIZE));
      if (templateCurrentPage > totalPages) templateCurrentPage = totalPages;
      if (templateCurrentPage < 1) templateCurrentPage = 1;
      var start = (templateCurrentPage - 1) * TEMPLATE_PAGE_SIZE;
      var pageItems = filtered.slice(start, start + TEMPLATE_PAGE_SIZE);
      for (var i = 0; i < pageItems.length; i++) {
        var t = pageItems[i];
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.setAttribute('data-url', t.url);
        var img = document.createElement('img');
        img.src = t.url;
        img.alt = t.alt;
        img.loading = 'lazy';
        var cap = document.createElement('span');
        cap.textContent = t.alt;
        btn.appendChild(img);
        {% comment %} btn.appendChild(cap); {% endcomment %}
        templateGrid.appendChild(btn);
      }
      if (templatePagination && templatePageInfo && templatePrev && templateNext) {
        if (totalPages > 1) {
          templatePagination.classList.remove('image-customizer-tool__hidden');
          templatePageInfo.textContent = 'Page ' + templateCurrentPage + ' of ' + totalPages + ' (' + filtered.length + ' images)';
          templatePrev.disabled = templateCurrentPage <= 1;
          templateNext.disabled = templateCurrentPage >= totalPages;
        } else {
          templatePagination.classList.add('image-customizer-tool__hidden');
        }
      }
    }

    templateItems = parseTemplateItems();
    renderTemplateGrid();
    updateSourceUI('upload');
    applyCanvasSizePreset('12x12');
    syncScaleOutputs();
    drawImage();

    if (uploadInput) {
      uploadInput.addEventListener('change', function(e) {
        if (e.target && e.target.files && e.target.files[0]) loadImageFromFile(e.target.files[0]);
      });
    }

    scaleSlider.addEventListener('input', function() {
      var m = getScaleSliderMax();
      var v = Math.min(Math.max(parseFloat(scaleSlider.value) || 0.1, 0.1), m);
      scaleSlider.value = v.toFixed(2);
      syncScaleOutputs();
      drawImage();
    });

    if (previewZoomOut) {
      previewZoomOut.addEventListener('click', function() {
        stepPreviewZoom(1 / PREVIEW_ZOOM_STEP);
      });
    }
    if (previewZoomIn) {
      previewZoomIn.addEventListener('click', function() {
        stepPreviewZoom(PREVIEW_ZOOM_STEP);
      });
    }

    widthInput.addEventListener('input', function() {
      var w = parseFloat(widthInput.value);
      if (!isFinite(w) || w <= 0) return;
      var m = getScaleSliderMax();
      w = Math.min(Math.max(w, 0.1), m);
      scaleSlider.value = w.toFixed(2);
      syncScaleOutputs();
      drawImage();
    });

    heightInput.addEventListener('input', function() {
      var h = parseFloat(heightInput.value);
      if (!isFinite(h) || h <= 0) return;
      var pw = h / Math.max(imageAspectRatio, 0.001);
      var m = getScaleSliderMax();
      pw = Math.min(Math.max(pw, 0.1), m);
      scaleSlider.value = pw.toFixed(2);
      syncScaleOutputs();
      drawImage();
    });

    sizeWrap.addEventListener('change', function(e) {
      var t = e.target;
      if (!t || t.type !== 'radio' || !t.value) return;
      applyCanvasSizePreset(t.value);
    });

    for (var r = 0; r < sourceRadios.length; r++) {
      sourceRadios[r].addEventListener('change', function(e) {
        if (!e.target) return;
        updateSourceUI(e.target.value);
        if (e.target.value === 'template') openTemplateModal();
      });
    }

    if (openTemplateButton) {
      openTemplateButton.addEventListener('click', function() {
        openTemplateModal();
      });
    }

    if (templateSearch) {
      templateSearch.addEventListener('input', function() {
        if (templateSearchTimer) clearTimeout(templateSearchTimer);
        templateSearchTimer = setTimeout(function() {
          templateCurrentPage = 1;
          renderTemplateGrid();
        }, 250);
      });
    }

    if (templatePrev) {
      templatePrev.addEventListener('click', function() {
        if (templateCurrentPage > 1) {
          templateCurrentPage--;
          renderTemplateGrid();
        }
      });
    }

    if (templateNext) {
      templateNext.addEventListener('click', function() {
        var filtered = getFilteredTemplateItems();
        var totalPages = Math.max(1, Math.ceil(filtered.length / TEMPLATE_PAGE_SIZE));
        if (templateCurrentPage < totalPages) {
          templateCurrentPage++;
          renderTemplateGrid();
        }
      });
    }

    if (templateModal) {
      templateModal.addEventListener('click', function(e) {
        var target = e.target;
        if (!target) return;
        if (target.hasAttribute('data-customizer-close-modal')) {
          closeTemplateModal();
          return;
        }
        var item = target.closest ? target.closest('button[data-url]') : null;
        if (item) {
          loadImageFromUrl(item.getAttribute('data-url'));
          closeTemplateModal();
        }
      });
    }

    window.addEventListener('resize', drawImage);
  })();
</script>

