<!-- /templates/cart.liquid -->

<div class="grid">
  <div class="grid__item">
    {% if cart.item_count > 0 %}
      <h1 class="h2 visually-hidden">{{ 'cart.general.title' | t }}</h1>
      <form action="/cart" method="post" novalidate class="cart">
        <table class="responsive-table table--no-border">
          <thead class="cart__row cart__header-labels small--hide">
            <th class="text-left cart__table-cell--image">{{ 'cart.label.product' | t }}</th>
            <th class="text-center cart__table-cell--meta"></th>
            <th class="text-center cart__table-cell--price">{{ 'cart.label.price' | t }}</th>
            <th class="text-center cart__table-cell--quantity">{{ 'cart.label.quantity' | t }}</th>
            <th class="text-right cart__table-cell--line-price">{{ 'cart.label.total' | t }}</th>
          </thead>
          <tbody>
            {% for item in cart.items %}
              <tr class="cart__row responsive-table__row">
                {% assign custom_image = '' %}

                {% for p in item.properties %}
                  {% assign prop_value = p.last | strip %}

                  {% if prop_value contains 'http' or prop_value contains 'cdn/shop' %}
                    {% comment %} Clean malformed URLs like "uploaded Image://..." {% endcomment %}
                    {% assign cleaned_url = prop_value
                      | replace: 'uploaded Image:', ''
                      | replace: 'image:', ''
                      | replace: 'Image:', ''
                      | strip
                    %}

                    {% assign custom_image = cleaned_url %}
                  {% endif %}
                {% endfor %}
                <td class="cart__table-cell--image small--text-center">
                  {% if custom_image != blank %}
                    <!-- Show uploaded image -->
                    <a href="{{ item.url | within: collections.all }}">
                      <img
                        id="{{ img_id }}"
                        src="{{ custom_image }}"
                        alt="Custom uploaded image"
                        class="cart_upload_img"
                      >
                    </a>

                  {% elsif item.image != blank %}
                    <!-- Default product image -->
                    {%- assign img_url = item.image | img_url: '1x1' | replace: '_1x1.', '_{width}x.' -%}
                    {%- capture wrapper_id -%}CartImageWrapper--{{ item.image.id }}{%- endcapture -%}
                    {%- capture img_id -%}CartImage--{{ item.image.id }}{%- endcapture -%}

                    {% render 'image-style' with image: item.image, width: 720, height: 600, small_style: false, wrapper_id: wrapper_id, img_id: img_id %}

                    <div id="{{ wrapper_id }}" class="cart__image-wrapper supports-js">
                      <a
                        class="cart__image-container"
                        href="{{ item.url | within: collections.all }}"
                        style="padding-top:{{ 1 | divided_by: item.image.aspect_ratio | times: 100}}%;"
                      >
                        <img
                          id="{{ img_id }}"
                          class="cart__image lazyload"
                          src="{{ item.image | img_url: '100x100' }}"
                          data-src="{{ img_url }}"
                          data-widths="[180, 230, 360, 540, 720, 900, 1080, 1296, 1512, 1728, 2048]"
                          data-aspectratio="{{ item.image.aspect_ratio }}"
                          data-sizes="auto"
                          alt="{{ item.title | escape }}"
                          itemprop="image"
                        >
                      </a>
                    </div>

                  {% else %}
                    <!-- Fallback -->
                    <a href="{{ item.url | within: collections.all }}">
                      <img src="{{ item | img_url: 'grande' }}" alt="{{ item.title | escape }}">
                    </a>
                  {% endif %}
                </td>
                {% comment %}
                  ---Backup default product image logic----

                   <td class="cart__table-cell--image small--text-center">
                    {% unless item.image == blank %}
                      {%- assign img_url = item.image | img_url: '1x1' | replace: '_1x1.', '_{width}x.' -%}
                      {%- capture wrapper_id -%}CartImageWrapper--{{ item.image.id }}{%- endcapture -%}
                      {%- capture img_id -%}CartImage--{{ item.image.id }}{%- endcapture -%}
                      {% include 'image-style' with image: item.image, width: 720, height: 600, small_style: false, wrapper_id: wrapper_id, img_id: img_id %}
                      <div id="{{ wrapper_id }}" class="cart__image-wrapper supports-js">
                        <a class="cart__image-container" href="{{ item.url | within: collections.all }}" style="padding-top:{{ 1 | divided_by: item.image.aspect_ratio | times: 100}}%;">
                          <img id="{{ img_id }}"
                               class="cart__image lazyload"
                               src="{{ item.image | img_url: '100x100' }}"
                               data-src="{{ img_url }}"
                               data-widths="[180, 230, 360, 540, 720, 900, 1080, 1296, 1512, 1728, 2048]"
                               data-aspectratio="{{ item.image.aspect_ratio }}"
                               data-sizes="auto"
                               alt="{{ item.title | escape }}"
                               itemprop="image">
                        </a>
                      </div>
                    {% else %}
                      <a class="supports-js" href="{{ item.url | within: collections.all }}">
                        <img src="{{ item | img_url: 'grande' }}" alt="{{ item.title | escape }}">
                      </a>
                    {% endunless %}
                    <noscript>
                      <a href="{{ item.url | within: collections.all }}">
                        <img class="cart__image" src="{{ item | img_url: 'grande' }}" alt="{{ item.title | escape }}">
                      </a>
                    </noscript>
                  </td>
                {% endcomment %}
                <td class="cart__table-cell--meta small--text-center">
                  <p>
                    <a href="{{ item.url }}">{{ item.product.title }}</a>
                    {% unless item.variant.title contains 'Default' %}
                      <br>
                      <small>{{ item.variant.title }}</small>
                    {% endunless %}

                    {% assign property_size = item.properties | size %}
                    {% if property_size > 0 %}
                      <ul class="cart-item__properties" aria-label="Item customization details">
                        {% for p in item.properties %}
  {% assign first_character_in_key = p.first | truncate: 1, '' %}

  {% unless p.last == blank or first_character_in_key == '_' or p.first == 'Template_Image' %}

    {%- comment -%} ✅ Normalize raw key for comparison {%- endcomment -%}
    {% assign raw_key_clean = p.first | strip | downcase %}

    {%- comment -%} ❌ Skip Canvas Size completely {%- endcomment -%}
    {% if raw_key_clean == "canvas size" or raw_key_clean == "canvas_size" %}
      {% continue %}
    {% endif %}

    {%- comment -%} ✏️ Format label {%- endcomment -%}
    {% assign raw_key = p.first | replace: '_', ' ' %}
    {% assign key_words = raw_key | split: ' ' %}

    {% capture formatted_key %}
      {% for word in key_words %}
        {{ word | downcase | capitalize }}{% unless forloop.last %} {% endunless %}
      {% endfor %}
    {% endcapture %}

    {%- comment -%} ✏️ Rename Canvas Scale → Scale {%- endcomment -%}
    {% if raw_key_clean == "canvas scale" or raw_key_clean == "canvas_scale" %}
      {% assign display_key = "Scale" %}
    {% else %}
      {% assign display_key = formatted_key | strip %}
    {% endif %}

    <li class="cart-item__property">
      <span class="cart-item__property-label">{{ display_key }}:</span>

      {% assign prop_value = p.last | strip %}

      {% if prop_value contains '/uploads/' or prop_value contains 'uploadery.s3' %}
        <a href="{{ prop_value }}" target="_blank" rel="noopener">View upload</a>

      {% elsif prop_value contains 'http://' or prop_value contains 'https://' %}
        <a href="{{ prop_value }}" target="_blank" rel="noopener">
          {{- prop_value | split: '/' | last -}}
        </a>

      {% else %}
        <span class="cart-item__property-value">{{ prop_value }}</span>
      {% endif %}
    </li>

  {% endunless %}
{% endfor %}
                        {% comment %} no value skip code
                          {% for p in item.properties %}
                          {% assign first_character_in_key = p.first | truncate: 1, '' %}
                          {% unless p.last == blank or first_character_in_key == '_' or p.first == 'Template_Image' %}
                            {% assign raw_key = p.first | replace: '_', ' ' %}
                            {% assign key_words = raw_key | split: ' ' %}
                            {% capture formatted_key %}
                              {% for word in key_words %}
                                {{ word | downcase | capitalize }}{% unless forloop.last %} {% endunless %}
                              {% endfor %}
                            {% endcapture %}
                            <li class="cart-item__property">
                              {% if formatted_key != "Canvas Size" %}
                                <span class="cart-item__property-label">{{ formatted_key | strip }}:</span>
                              {% endif %}
                              {% assign prop_value = p.last | strip %}
                              {% if prop_value contains '/uploads/' or prop_value contains 'uploadery.s3' %}
                                <a href="{{ prop_value }}" target="_blank" rel="noopener">View upload</a>
                              {% elsif prop_value contains 'http://' or prop_value contains 'https://' %}
                                <a href="{{ prop_value }}" target="_blank" rel="noopener">
                                  {{- prop_value | split: '/' | last -}}
                                </a>
                              {% else %}
                                <span class="cart-item__property-value">{{ prop_value }}</span>
                                
                              {% endif %}
                            </li>
                          {% endunless %}
                        {% endfor %} {% endcomment %}
                      </ul>
                    {% endif %}
                  </p>

                  <p class="txt--minor">
                    <a href="/cart/change?line={{ forloop.index }}&amp;quantity=0" class="cart__remove">
                      {{- 'cart.general.remove' | t -}}
                    </a>
                  </p>
                </td>
                <td class="cart__table-cell--price medium-up--text-center" data-label="{{ 'cart.label.price' | t }}">
                  <span>
                    {{ item.price | money }}
                  </span>
                </td>
                <td
                  data-label="{{ 'cart.label.quantity' | t }}"
                  class="medium-up--text-center cart__table-cell--quantity"
                >
                  <label class="visually-hidden" for="updates_{{ item.key }}">{{ 'cart.label.quantity' | t }}</label>
                  <input
                    class="quantity-selector"
                    type="number"
                    name="updates[]"
                    id="updates_{{ item.key }}"
                    value="{{ item.quantity }}"
                    min="0"
                  >
                </td>
                <td data-label="{{ 'cart.label.total' | t }}" class="text-right cart__table-cell--line-price">
                  {% if item.original_line_price != item.line_price %}
                    <p class="cart-item__original-price">
                      <small
                        ><s>{{ item.original_line_price | money }}</s></small
                      >
                    </p>
                  {% endif %}
                  <span>
                    {{ item.line_price | money }}
                  </span>
                  {% for discount in item.discounts %}
                    <p class="cart-item__discount">
                      <small>{{ discount.title }}</small>
                    </p>
                  {% endfor %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>

        <footer class="cart__footer">
          <div class="grid">
            <div class="grid__item medium-up--one-half">
              <label for="CartSpecialInstructions" class="label--block">{{ 'cart.general.note' | t }}</label>
              <textarea
                name="note"
                id="CartSpecialInstructions"
                class="input--block cart__note"
              >{{ cart.note }}</textarea>
            </div>
            <div class="grid__item text-center medium-up--one-half medium-up--text-right">
              <p>
                <span class="cart__subtotal-title h3">{{ 'cart.general.subtotal' | t }}</span>
                <span class="cart__subtotal h3">{{ cart.total_price | money }}</span>
              </p>
              {% if cart.total_discounts > 0 %}
                {% assign savings = cart.total_discounts | money %}
                <p>
                  <span class="cart-subtotal__savings"
                    ><em>{{ 'cart.general.savings_html' | t: price: savings }}</em></span
                  >
                </p>
              {% endif %}

              {%- capture taxes_shipping_checkout -%}
                {%- if shop.taxes_included and shop.shipping_policy.body != blank -%}
                  {{ 'cart.general.taxes_included_and_shipping_policy_html' | t: link: shop.shipping_policy.url }}
                {%- elsif shop.taxes_included -%}
                  {{ 'cart.general.taxes_included_but_shipping_at_checkout' | t }}
                {%- elsif shop.shipping_policy.body != blank -%}
                  {{ 'cart.general.taxes_and_shipping_policy_at_checkout_html' | t: link: shop.shipping_policy.url }}
                {%- else -%}
                  {{ 'cart.general.taxes_and_shipping_at_checkout' | t }}
                {%- endif -%}
              {%- endcapture -%}

              <p class="cart__policies txt--emphasis rte">{{ taxes_shipping_checkout }}</p>

              <!-- Route Code Edited 01/04/2022 -->
              <div class="route-div"></div>
              <!-- End Route Code -->

              <p>
                <button type="submit" name="update" class="btn btn--secondary update-cart">
                  {% include 'icon-update' %}
                  <span class="icon__fallback-text">{{ 'cart.general.update' | t }}</span>
                </button>
                <a class="btn btn--secondary" href="/collections/all">{{ 'cart.general.continue_shopping' | t }}</a>
              </p>
              <p>
                <button type="submit" name="checkout" class="btn">{{ 'cart.general.checkout' | t }}</button>
              </p>
            </div>
          </div>
        </footer>
      </form>
    {% else %}
      {% comment %}
        The cart is empty
      {% endcomment %}
      <div id="EmptyCart">
        <h1>{{ 'cart.general.title' | t }}</h1>
        <p class="cart--empty-message">{{ 'cart.general.empty' | t }}</p>
        <p class="cart--continue-message">{{ 'cart.general.continue_browsing_html' | t }}</p>
        <p class="cart--cookie-message">{{ 'cart.general.cookies_required' | t }}</p>
      </div>
    {% endif %}
  </div>
</div>

<script src="https://widget.sezzle.com/v1/javascript/price-widget?uuid=d3fb6fec-437d-40fc-b48f-109b17ae3a74"></script>

{% section 'sezzle-widget' %}

<style>
  .cart-item__properties {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  .cart-item__property {
    margin: 0 0 4px;
    line-height: 1.35;
    word-break: break-word;
  }

  .cart-item__property-label {
    font-weight: 600;
    color: #4b1f2f;
  }

  .cart-item__property-value {
    color: inherit;
  }
</style>
